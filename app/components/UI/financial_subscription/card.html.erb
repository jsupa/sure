<div class="bg-white rounded-lg border border-secondary p-4">
  <div class="flex items-start justify-between">
    <div class="flex-1">
      <h3 class="font-semibold text-primary"><%= subscription.name %></h3>
      <p class="text-sm text-secondary mt-1">From: <%= subscription.account.name %></p>
      <p class="text-sm text-secondary">Amount: <%= amount_display %> (<%= recurrence_text %>)</p>
      <% if subscription.description.present? %>
        <p class="text-sm text-secondary/80 mt-2"><%= subscription.description %></p>
      <% end %>
    </div>
    
    <div class="text-right">
      <p class="text-sm <%= status_color %> font-medium">
        <%= status_text %>
      </p>
      
      <% if show_actions %>
        <div class="mt-3 flex gap-2">
          <% if subscription.overdue? %>
            <%= button_to mark_as_paid_financial_subscription_path(subscription), 
                method: :patch, 
                local: false,
                class: "inline-flex items-center px-3 py-1.5 text-xs font-medium rounded text-white bg-green-600 hover:bg-green-700",
                data: { confirm: "Mark this subscription as paid?" } do %>
              <%= icon "check", class: "w-3 h-3 mr-1" %>
              Mark as Paid
            <% end %>
          <% end %>
          
          <%= link_to edit_financial_subscription_path(subscription),
              class: "inline-flex items-center px-3 py-1.5 border border-secondary text-xs font-medium rounded text-secondary hover:bg-container" do %>
            <%= icon "pencil", class: "w-3 h-3 mr-1" %>
            Edit
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>