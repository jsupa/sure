<div class="bg-container rounded-lg border border-secondary p-3">
  <div class="flex items-center justify-between">
    <div>
      <h4 class="font-medium text-primary"><%= payment.subscription_name %></h4>
      <p class="text-sm text-secondary">From: <%= payment.subscription_account.name %></p>
      <p class="text-sm text-secondary/80">Paid on: <%= payment_date_display %></p>
    </div>
    
    <div class="text-right">
      <p class="font-semibold text-primary"><%= amount_display %></p>
      <%= link_to payment.transaction, 
          class: "text-xs text-blue-600 hover:text-blue-800" do %>
        View Transaction
      <% end %>
    </div>
  </div>
</div>