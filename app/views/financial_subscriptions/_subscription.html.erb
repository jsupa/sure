<%# locals: (subscription:, show_mark_paid: false) %>

<%= turbo_frame_tag dom_id(subscription) do %>
  <div class="p-4 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3 flex-1">
      <div class="w-10 h-10 bg-alpha-black-25 rounded-lg flex items-center justify-center">
        <%= icon("credit-card", class: "w-5 h-5 text-secondary") %>
      </div>

      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <%= link_to subscription.name, 
              edit_financial_subscription_path(subscription), 
              class: "font-medium text-primary truncate hover:text-blue-600 hover:underline transition-colors cursor-pointer",
              data: { turbo_frame: "modal" } %>
          <% if subscription.overdue? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
              <%= pluralize(subscription.days_overdue, "day") %> overdue
            </span>
          <% end %>
        </div>
        
        <div class="flex items-center gap-4 text-sm text-secondary">
          <span class="font-medium"><%= subscription.amount_money&.format %></span>
          <span><%= subscription.recurrence.humanize %></span>
          <span>from <%= subscription.account.name %></span>
          <% if subscription.currency != Current.family.currency %>
            <span class="text-xs bg-alpha-black-25 px-2 py-0.5 rounded">
              <%= subscription.currency %>
            </span>
          <% end %>
        </div>
        <% if subscription.description.present? %>
          <p class="text-sm text-secondary truncate mt-1"><%= subscription.description %></p>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="text-right">
        <p class="text-sm font-medium text-primary">
          <%= subscription.next_payment_date.strftime('%b %d, %Y') %>
        </p>
        <p class="text-xs text-secondary">Next payment</p>
      </div>

      <!-- Always visible pay button -->
      <div class="flex items-center">
        <% if show_mark_paid && subscription.overdue? %>
          <%= render DS::Button.new(
            text: "Pay",
            href: mark_as_paid_financial_subscription_path(subscription),
            method: :patch,
            variant: "danger",
            size: "sm",
            icon: "credit-card",
            confirm: CustomConfirm.new(
              title: "Mark as Paid?",
              body: "This will record a payment for #{subscription.name} and update the next payment date.",
              btn_text: "Mark as Paid"
            ),
            frame: "_top"
          ) %>
        <% elsif subscription.next_payment_date == Date.current %>
          <%= render DS::Button.new(
            text: "Pay Now",
            href: mark_as_paid_financial_subscription_path(subscription),
            method: :patch,
            variant: "primary",
            size: "sm",
            icon: "credit-card",
            confirm: CustomConfirm.new(
              title: "Record Payment?",
              body: "This will mark #{subscription.name} as paid for today and update the next payment date.",
              btn_text: "Record Payment"
            ),
            frame: "_top"
          ) %>
        <% elsif subscription.next_payment_date <= 7.days.from_now %>
          <%= render DS::Button.new(
            text: "Pay Early",
            href: mark_as_paid_financial_subscription_path(subscription),
            method: :patch,
            variant: "ghost",
            size: "sm",
            icon: "credit-card",
            confirm: CustomConfirm.new(
              title: "Pay Early?",
              body: "This will record an early payment for #{subscription.name} and update the next payment date.",
              btn_text: "Pay Early"
            ),
            frame: "_top"
          ) %>
        <% else %>
          <%= render DS::Button.new(
            text: "Pay",
            href: mark_as_paid_financial_subscription_path(subscription),
            method: :patch,
            variant: "outline",
            size: "sm",
            icon: "credit-card",
            confirm: CustomConfirm.new(
              title: "Record Payment?",
              body: "This will record a payment for #{subscription.name} and update the next payment date.",
              btn_text: "Record Payment"
            ),
            frame: "_top"
          ) %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>