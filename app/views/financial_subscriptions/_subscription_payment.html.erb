<%# locals: (payment:) %>

<div class="grid grid-cols-12 items-center text-primary text-sm font-medium p-4 lg:p-4">

  <div class="pr-4 lg:pr-10 flex items-center gap-3 lg:gap-4 col-span-8">
    <div class="max-w-full">
      <%= content_tag :div, class: ["flex items-center gap-2"] do %>
        <div class="w-6 h-6 bg-green-100 theme-dark:bg-green-900/50 rounded-full flex items-center justify-center flex-shrink-0">
          <%= icon("check-circle", class: "w-4 h-4 text-green-600 theme-dark:text-green-400") %>
        </div>

        <div class="truncate">
          <div class="space-y-0.5">
            <div class="flex items-center gap-1 min-w-0">
              <div class="truncate flex-shrink">
                <span class="font-medium"><%= payment.subscription_name %></span>
              </div>

              <div class="flex items-center gap-1 flex-shrink-0">
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-green-100 theme-dark:bg-green-900/50 text-green-800 theme-dark:text-green-300">
                  Paid
                </span>
              </div>
            </div>

            <div class="text-secondary text-xs font-normal hidden lg:block">
              Payment • 
              <%= link_to payment.subscription_account.name,
                  account_path(payment.subscription_account, tab: "transactions"),
                  data: { turbo_frame: "_top" },
                  class: "hover:underline" %>
              • <%= payment.payment_date.strftime('%b %d, %Y') %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="hidden lg:flex items-center gap-1 col-span-2">
    <div class="text-right">
      <p class="text-xs text-secondary">Paid on</p>
      <p class="text-sm font-medium text-primary">
        <%= payment.payment_date.strftime('%b %d') %>
      </p>
    </div>
  </div>

  <div class="col-span-2 ml-auto text-right flex items-center gap-2">
    <div class="text-right">
      <p class="font-medium text-primary">
        <%= payment.amount_money&.format %>
      </p>
      <div class="lg:hidden">
        <p class="text-xs text-secondary">
          <%= payment.payment_date.strftime('%b %d') %>
        </p>
      </div>
    </div>

    <div class="flex items-center">
      <% if payment.transaction&.entry %>
        <%= link_to entry_path(payment.transaction.entry),
            data: { 
              turbo_frame: "drawer",
              turbo_prefetch: false
            },
            class: "font-medium whitespace-nowrap inline-flex items-center gap-1 rounded-md px-2 py-1 text-sm text-primary bg-transparent hover:bg-gray-100 theme-dark:hover:bg-gray-700" do %>
          <%= icon("external-link", class: "w-4 h-4") %>
          View
        <% end %>
      <% else %>
        <span class="font-medium whitespace-nowrap inline-flex items-center gap-1 rounded-md px-2 py-1 text-sm text-secondary">
          <%= icon("external-link", class: "w-4 h-4") %>
          No transaction
        </span>
      <% end %>
    </div>
  </div>
</div>