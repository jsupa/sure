<div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-200">
  <div class="flex-1">
    <div class="flex items-center gap-3">
      <div class="w-2 h-2 bg-green-500 rounded-full"></div>
      <div class="flex-1">
        <h4 class="font-medium text-primary"><%= payment.subscription_name %></h4>
        <p class="text-sm text-secondary">
          <%= payment.subscription_account.name %> • 
          <%= payment.amount_money.format %>
        </p>
      </div>
      
      <div class="text-right">
        <p class="text-sm text-secondary">
          Paid <%= payment.payment_date.strftime("%b %d, %Y") %>
        </p>
        <p class="text-xs text-secondary">
          <%= time_ago_in_words(payment.payment_date) %> ago
        </p>
      </div>
    </div>
  </div>
  
  <div class="ml-4">
    <%= link_to "View transaction", 
        transaction_path(payment.transaction), 
        class: "text-sm text-secondary hover:text-primary px-2 py-1" %>
  </div>
</div>