<%# locals: (financial_subscription:) %>

<%= styled_form_with model: financial_subscription, class: "space-y-4", data: { turbo_frame: "_top" } do |f| %>
  <% if financial_subscription.errors.any? %>
    <%= render "shared/form_errors", model: financial_subscription %>
  <% end %>

  <section class="space-y-2">
    <%= f.text_field :name, label: "Subscription name", placeholder: "Netflix, Spotify, etc.", required: true %>
    
    <%= f.collection_select :account_id, 
        Current.family.accounts.visible.alphabetically, 
        :id, :name, 
        { prompt: "Select account", label: "Payment account" }, 
        required: true, 
        class: "form-field__input text-ellipsis" %>
    
    <%= f.money_field :amount, label: "Amount", required: true, default_currency: Current.family.currency %>
    
    <%= f.select :recurrence, 
        options_for_select([
          ['Daily', 'daily'],
          ['Weekly', 'weekly'],
          ['Monthly', 'monthly'],
          ['Quarterly', 'quarterly'],
          ['Yearly', 'yearly']
        ], financial_subscription.recurrence), 
        { prompt: "Select frequency", label: "Frequency" }, 
        required: true %>
    
    <%= f.date_field :next_payment_date, 
        label: "Next payment date", 
        required: true, 
        value: financial_subscription.next_payment_date || Date.current %>
  </section>

  <%= render DS::Disclosure.new(title: "Details") do %>
    <% if financial_subscription.persisted? && financial_subscription.currency != Current.family.currency %>
      <div class="mb-4 p-3 bg-surface-inset rounded-lg">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-primary">Converted Amount</p>
            <% begin %>
              <% converted_amount = financial_subscription.monthly_equivalent_amount_in_currency(Current.family.currency) %>
              <% original_amount = financial_subscription.amount %>
              <% if converted_amount > 0 && original_amount > 0 %>
                <p class="text-xs text-secondary">
                  <%= number_to_currency(original_amount, unit: financial_subscription.currency + " ") %> → 
                  <%= number_to_currency(converted_amount, unit: Current.family.currency + " ") %>
                </p>
              <% else %>
                <p class="text-xs text-secondary">
                  <%= financial_subscription.currency %> → <%= Current.family.currency %>
                </p>
              <% end %>
            <% rescue => e %>
              <p class="text-xs text-secondary">
                <%= financial_subscription.currency %> → <%= Current.family.currency %>
              </p>
            <% end %>
          </div>
          <div class="text-right">
            <% begin %>
              <% converted_amount = financial_subscription.monthly_equivalent_amount_in_currency(Current.family.currency) %>
              <% if converted_amount > 0 %>
                <p class="text-sm font-medium text-primary">
                  <%= Money.new(converted_amount, Current.family.currency).format %>
                </p>
                <% if financial_subscription.amount > 0 %>
                  <p class="text-xs text-secondary">
                    ≈ <%= number_with_precision(converted_amount / financial_subscription.amount, precision: 4) %> rate
                  </p>
                <% end %>
              <% else %>
                <p class="text-sm text-secondary">
                  Conversion unavailable
                </p>
              <% end %>
            <% rescue => e %>
              <p class="text-sm text-secondary">
                Conversion unavailable
              </p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    
    <%= f.text_area :description,
        label: "Description",
        placeholder: "Optional notes about this subscription",
        rows: 3 %>
  <% end %>

  <footer class="pt-4 border-t border-alpha-black-50 flex items-center justify-between">
    <% if financial_subscription.persisted? %>
      <%= render DS::Link.new(
        text: "Delete", 
        href: financial_subscription_path(financial_subscription),
        variant: "destructive",
        method: :delete,
        confirm: "Are you sure you want to delete this subscription? This cannot be undone."
      ) %>
    <% end %>
    
    <div class="flex items-center gap-2">
      <%= render DS::Link.new(
        text: "Cancel",
        href: financial_subscriptions_path,
        variant: "ghost"
      ) %>
      
      <%= f.submit financial_subscription.persisted? ? "Update subscription" : "Create subscription",
          class: "btn btn--primary" %>
    </div>
  </footer>
<% end %>