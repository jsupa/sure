<div class="flex items-center justify-between p-3 bg-white rounded-lg border <%= overdue ? 'border-red-300' : 'border-gray-200' %>" 
     id="<%= dom_id(subscription) %>">
  <div class="flex-1">
    <div class="flex items-center gap-3">
      <div class="flex-1">
        <h3 class="font-medium text-primary"><%= subscription.name %></h3>
        <p class="text-sm text-secondary">
          <%= subscription.account.name %> • 
          <%= subscription.amount_money.format %> 
          <%= subscription.recurrence.humanize %>
        </p>
        <% if subscription.description.present? %>
          <p class="text-xs text-secondary mt-1"><%= subscription.description %></p>
        <% end %>
      </div>
      
      <div class="text-right">
        <p class="text-sm <%= overdue ? 'text-red-600 font-semibold' : 'text-secondary' %>">
          <%= overdue ? "#{subscription.days_overdue} days overdue" : "Due #{time_ago_in_words(subscription.next_payment_date)} from now" %>
        </p>
        <p class="text-xs text-secondary">
          <%= subscription.next_payment_date.strftime("%b %d, %Y") %>
        </p>
      </div>
    </div>
  </div>
  
  <div class="flex items-center gap-2 ml-4">
    <%= link_to "Edit", 
        edit_financial_subscription_path(subscription), 
        class: "text-sm text-secondary hover:text-primary px-2 py-1" %>
    
    <%= button_to "Mark as Paid", 
        mark_as_paid_financial_subscription_path(subscription), 
        method: :patch,
        data: { 
          turbo_method: :patch,
          confirm: "Mark #{subscription.name} payment as paid for #{subscription.amount_money.format}?" 
        },
        class: "px-3 py-1 text-sm bg-green-600 text-white rounded hover:bg-green-700" %>
  </div>
</div>